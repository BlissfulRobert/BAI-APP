# ==============================================================================
# Environment Variables Blueprint (.env.example)
# Copy this file to '.env' and fill in the values for your local environment.
# ==============================================================================

# Target Django settings module (e.g., core.settings.dev or core.settings.production)
DJANGO_SETTINGS_MODULE=core.settings.dev

# Unique secret key for cryptographic signing (Generate a new key for production)
SECRET_KEY=

# Set to True for local development; NEVER set to True in production!
DEBUG=True

# Comma-separated list of host/domain names this Django site can serve
ALLOWED_HOSTS=localhost,127.0.0.1

# Supabase PostgreSQL connection
DATABASE_URL=postgresql://postgres.<SUPABASE_PROJECT_REF>:<DATABASE_PASSWORD>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres